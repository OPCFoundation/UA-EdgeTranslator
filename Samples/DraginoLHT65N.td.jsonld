{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    { "lorav": "https://www.w3.org/2026/wot/lorawan#" }
  ],
  "id": "urn:dragino-lht-65n-e3",
  "securityDefinitions": {
    "otaa_sc": {
      "scheme": "apikey",
      "in": "header",
      "name": "appKey",
      "description": "LoRaWAN OTAA AppKey. Injected at runtime via the LORAWAN_APPKEY_A84041B98D5CB233 environment variable; never stored in this file."
    }
  },
  "security": [
    "otaa_sc"
  ],
  "@type": [
    "Thing"
  ],
  "name": "Dragino LHT65N-E3 A84041B98D5CB233",
  "base": "lorawan://localhost/A84041B98D5CB233/",
  "title": "Dragino LHT65N-E3",
  "lorav:payloadLayout": "fixed",
  "lorav:devEUI": "A84041B98D5CB233",
  "lorav:joinEUI": "0000000000000000",
  "lorav:macVersion": "1.0.3",
  "lorav:brand": "Dragino",
  "lorav:model": "LHT65N-E3",
  "events": {
    "batteryLevel": {
      "data": {
        "type": "number",
        "uav:mapToNodeId": "s=A84041B98D5CB233_BatteryLevel"
      },
      "forms": [
        {
          "href": "uplink",
          "op": [ "subscribeevent", "unsubscribeevent" ],
          "type": "xsd:short",
          "lorav:byteOffset": 0,
          "lorav:byteLength": 2,
          "lorav:wireType": "xsd:unsignedShort",
          "lorav:endian": "big",
          "lorav:bitmask": "0x3FFF",
          "lorav:multiplier": 0.001
        }
      ]
    },
    "temperature": {
      "data": {
        "type": "number",
        "uav:mapToNodeId": "s=A84041B98D5CB233_Temperature"
      },
      "forms": [
        {
          "href": "uplink",
          "op": [ "subscribeevent", "unsubscribeevent" ],
          "type": "xsd:short",
          "lorav:byteOffset": 2,
          "lorav:byteLength": 2,
          "lorav:wireType": "xsd:short",
          "lorav:endian": "big",
          "lorav:multiplier": 0.01
        }
      ]
    },
    "humidity": {
      "data": {
        "type": "number",
        "uav:mapToNodeId": "s=A84041B98D5CB233_Humidity"
      },
      "forms": [
        {
          "href": "uplink",
          "op": [ "subscribeevent", "unsubscribeevent" ],
          "type": "xsd:short",
          "lorav:byteOffset": 4,
          "lorav:byteLength": 2,
          "lorav:wireType": "xsd:unsignedShort",
          "lorav:endian": "big",
          "lorav:multiplier": 0.1
        }
      ]
    },
    "extTemperature": {
      "data": {
        "type": "number",
        "uav:mapToNodeId": "s=A84041B98D5CB233_ExternalTemperature"
      },
      "forms": [
        {
          "href": "uplink",
          "op": [ "subscribeevent", "unsubscribeevent" ],
          "type": "xsd:short",
          "lorav:byteOffset": 7,
          "lorav:byteLength": 2,
          "lorav:wireType": "xsd:short",
          "lorav:endian": "big",
          "lorav:multiplier": 0.01
        }
      ]
    }
  }
}
