<?xml version="1.0" encoding="utf-8"?>
<!--
  Code-coverage settings for UA Edge Translator.

  Coverage is deliberately scoped to the UA Edge Translator SERVER assembly.

  The protocol driver projects are referenced by the test project so that the
  shared ProtocolDriverContractTests exercise the IProtocolDriver contract of
  every driver, but they are excluded from the coverage *metric* because the
  bulk of their code is vendored third-party libraries that this repository
  does not own and should not be judged on:

	  ProtocolDrivers/LoRaWAN/LoRaWanNetworkServer   (LoRaWAN network server)
	  ProtocolDrivers/Matter/MatterController        (Matter controller)
	  ProtocolDrivers/IEC61850/IEC61850forCSharp     (libiec61850 C# bindings)
	  ProtocolDrivers/OCPP/OCPPCentralSystem         (OCPP central system)

  That is ~23k lines of vendored code against ~9k lines of first-party driver
  code. Including it makes the headline number a measure of how much
  third-party source happens to be vendored, not of how well this project is
  tested.

  The drivers remain fully built and contract-tested; only the percentage is
  scoped.
-->
<RunSettings>
  <DataCollectionRunSettings>
	<DataCollectors>
	  <DataCollector friendlyName="XPlat code coverage">
		<Configuration>
		  <Format>cobertura</Format>

		  <!-- Measure the server assembly only. -->
		  <Include>[UAEdgeTranslator]*</Include>

		  <!-- Test doubles and generated/vendored code never count. -->
		  <Exclude>[UAEdgeTranslator.Tests]*,[Mock]*</Exclude>
		  <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
		  <SingleHit>false</SingleHit>
		  <UseSourceLink>false</UseSourceLink>
		  <IncludeTestAssembly>false</IncludeTestAssembly>
		</Configuration>
	  </DataCollector>
	</DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
