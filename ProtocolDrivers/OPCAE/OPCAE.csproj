<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x86</Platforms>
    <PlatformTarget Condition="'$(Platform)' == 'x86'">x86</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' != 'x86'">x64</PlatformTarget>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Official OPC Foundation Classic .NET API. Its net10.0-windows target
         brings the COM RCW and managed API needed for local OPC A&E. -->
    <PackageReference Include="OpcNetApi.Com" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\UAServer\UAEdgeTranslator.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
      <SetTargetFramework>TargetFramework=net10.0-windows</SetTargetFramework>
      <SetPlatform>Platform=x86</SetPlatform>
      <GlobalPropertiesToRemove>RuntimeIdentifier</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemGroup>

</Project>