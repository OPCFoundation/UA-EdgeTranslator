@page "/wot"
@using System.IO
@using Newtonsoft.Json.Linq
@using Opc.Ua.Edge.Translator
@using Opc.Ua.Edge.Translator.Models
@inject DiagnosticsService Diagnostics
@implements IDisposable

<PageTitle>WoT Files &middot; UA Edge Translator</PageTitle>

<PageHeader Title="WoT Files" Subtitle="Loaded Thing Descriptions" OnRefresh="Reload">
    <Actions>
        <label class="btn-refresh import-wot-btn @(_importing ? "is-busy" : null)" title="Import a Thing Description or Thing Model (.jsonld) file">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                <path d="M7 10l5 5 5-5" />
                <path d="M12 15V3" />
            </svg>
            <span>@(_importing ? "Importing…" : "Import WoT File")</span>
            <InputFile @key="_inputKey" OnChange="ImportFileAsync" accept=".jsonld,.json" disabled="@_importing" style="display:none" />
        </label>
        <button type="button" class="btn-refresh" disabled="@(_onboarding || _importing)" @onclick="OnboardAllAsync" title="Onboard every WoT file in the settings folder that is not loaded yet">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12l5 5L20 7" />
            </svg>
            <span>@(_onboarding ? "Onboarding\u2026" : "Onboard All")</span>
        </button>
    </Actions>
</PageHeader>

@if (!string.IsNullOrEmpty(_importError))
{
    <div class="banner banner-warning">@_importError</div>
}
else if (!string.IsNullOrEmpty(_importMessage))
{
    <div class="banner banner-success">@_importMessage</div>
}

@if (_files is null)
{
    <div class="loading">Loading…</div>
}
else if (_files.Count == 0)
{
    <div class="empty-state">
        <div class="empty-state-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                <path d="M14 2v6h6" />
            </svg>
        </div>
        <h2>No WoT files loaded</h2>
        <p>Thing Description files placed in the settings folder will appear here.</p>
    </div>
}
else
{
    <div class="split">
        <div class="list-pane">
            @foreach (var file in _files)
            {
                <button type="button" class="list-item @(ReferenceEquals(file, _selected) ? "active" : null)" @onclick="() => Select(file)">
                    <span class="list-item-title">@DisplayName(file)</span>
                    <span class="list-item-sub mono">@file.FileName</span>
                </button>
            }
        </div>

        <div class="detail-pane">
            @if (_selected is null)
            {
                <p class="muted">Select a file to view its details.</p>
            }
            else
            {
                <div class="detail-header">
                    <h2 class="detail-title">@DisplayName(_selected)</h2>
                    @if (!string.IsNullOrEmpty(_selected.Base))
                    {
                        <span class="pill pill-blue">@Scheme(_selected.Base)</span>
                    }
                    <div class="detail-actions">
                        <a class="btn-trust" href="@($"wot/download/{Uri.EscapeDataString(_selected.FileName)}")" download="@_selected.FileName" title="Download this Thing Description file">Export</a>
                        <button type="button" class="btn-danger detail-unload" disabled="@_unloading" @onclick="() => UnloadAsync(_selected)" title="Delete this Thing Description and remove it from the server">
                            @(_unloading ? "Deleting\u2026" : "Delete")
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_selected.ParseError))
                {
                    <div class="banner banner-warning">Could not fully parse this Thing Description: @_selected.ParseError</div>
                }

                <div class="kv-table">
                    @if (!string.IsNullOrEmpty(_selected.Name))
                    {
                        <div class="kv-row"><span class="kv-key">Name</span><span class="kv-value">@_selected.Name</span></div>
                    }
                    @if (!string.IsNullOrEmpty(_selected.Description))
                    {
                        <div class="kv-row"><span class="kv-key">Description</span><span class="kv-value">@_selected.Description</span></div>
                    }
                    @if (!string.IsNullOrEmpty(_selected.Base))
                    {
                        <div class="kv-row"><span class="kv-key">Base</span><span class="kv-value mono">@_selected.Base</span></div>
                    }
                    <div class="kv-row"><span class="kv-key">Properties</span><span class="kv-value">@_selected.PropertyCount</span></div>
                    <div class="kv-row"><span class="kv-key">Actions</span><span class="kv-value">@_selected.ActionCount</span></div>
                    <div class="kv-row"><span class="kv-key">Size</span><span class="kv-value">@FormatBytes(_selected.SizeBytes)</span></div>
                    <div class="kv-row"><span class="kv-key">Modified</span><span class="kv-value">@(_selected.LastModifiedUtc.ToString("yyyy-MM-dd HH:mm")) UTC</span></div>
                </div>

                <div class="code-toolbar">
                    <span class="code-label">Thing Description (JSON-LD)</span>
                    <div class="seg">
                        <button type="button" class="seg-btn @(_showRaw ? null : "active")" @onclick="() => _showRaw = false">Tree</button>
                        <button type="button" class="seg-btn @(_showRaw ? "active" : null)" @onclick="() => _showRaw = true">Raw</button>
                    </div>
                </div>

                @if (!_showRaw && _selectedJson is not null)
                {
                    <div class="json-tree">
                        <JsonTreeView Node="_selectedJson" Depth="0" @key="_selected.FileName" />
                    </div>
                }
                else
                {
                    <pre class="code-block"><code>@_selected.PrettyJson</code></pre>
                }
            }
        </div>
    </div>
}

@if (_thingModel is not null)
{
    <div class="dialog-backdrop" @onclick="CancelThingModelDialog"></div>
    <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="tm-dialog-title">
        <h2 id="tm-dialog-title" class="dialog-title">Create Thing Description</h2>
        <p class="dialog-hint"><span class="mono">@_thingModelFileName</span> is a Thing Model.</p>
        @if (_tmPlaceholders.Count == 0)
        {
            <p class="dialog-hint">The Thing Model has no placeholders; the Thing Description is created by removing its <span class="mono">tm:ThingModel</span> marker.</p>
        }
        else
        {
            <p class="dialog-hint">Provide a value for each Thing Model placeholder.</p>
            <div class="td-placeholders">
                @foreach (string name in _tmPlaceholders)
                {
                    <label class="dialog-field">
                        <span class="mono">@name</span>
                        <input class="mono" value="@(_tmValues.TryGetValue(name, out string value) ? value : string.Empty)"
                               @onchange="e => _tmValues[name] = e.Value?.ToString() ?? string.Empty" />
                    </label>
                }
            </div>
        }
        <label class="dialog-field">
            <span>Name</span>
            <input class="mono tm-name" @bind="_tmName" @bind:event="oninput" placeholder="letters, digits, '.', '_' and '-'" />
        </label>
        <p class="dialog-hint">The name identifies the asset, its settings file and its OPC UA namespace.</p>
        @if (!string.IsNullOrEmpty(_tmError))
        {
            <div class="banner banner-warning">@_tmError</div>
        }
        <div class="dialog-actions">
            <button type="button" class="btn-refresh" disabled="@_importing" @onclick="CancelThingModelDialog">Cancel</button>
            <button type="button" class="btn-trust tm-create" disabled="@(_importing || string.IsNullOrWhiteSpace(_tmName))" @onclick="ConfirmThingModelDialogAsync">@(_importing ? "Importing\u2026" : "Create & Import")</button>
        </div>
    </div>
}

@code {
    private IReadOnlyList<WoTFileInfo> _files;
    private WoTFileInfo _selected;
    private JToken _selectedJson;
    private bool _showRaw;

    private bool _importing;
    private bool _unloading;
    private bool _onboarding;
    private string _importError;
    private string _importMessage;
    private Guid _inputKey = Guid.NewGuid();
    private PeriodicTimer _timer;

    // Thing Model -> Thing Description dialog, open while _thingModel is set.
    private WotMappingDocument _thingModel;
    private string _thingModelFileName;
    private IReadOnlyList<string> _tmPlaceholders = [];
    private readonly Dictionary<string, string> _tmValues = new(StringComparer.Ordinal);
    private string _tmName;
    private string _tmError;

    protected override void OnInitialized()
    {
        Reload();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        _ = RefreshLoopAsync();
    }

    private async Task RefreshLoopAsync()
    {
        try
        {
            while (await _timer.WaitForNextTickAsync())
            {
                // Marshal the reload onto the render sync-context so the periodic
                // list refresh cannot interleave with user actions (Select/Import)
                // that mutate the same selection fields.
                await InvokeAsync(() =>
                {
                    Reload();
                    StateHasChanged();
                });
            }
        }
        catch (ObjectDisposedException)
        {
            // The component was disposed between ticks; stop refreshing.
        }
    }

    public void Dispose() => _timer?.Dispose();

    private void Reload()
    {
        _files = Diagnostics.GetWoTFiles();

        if (_selected is not null)
        {
            _selected = _files.FirstOrDefault(f => f.FileName == _selected.FileName);
        }

        _selected ??= _files.FirstOrDefault();

        ParseSelected();
    }

    private void Select(WoTFileInfo file)
    {
        _selected = file;
        ParseSelected();
    }

    private async Task ImportFileAsync(InputFileChangeEventArgs e)
    {
        IBrowserFile file = e.File;
        if (file is null)
        {
            return;
        }

        _importing = true;
        _importError = null;
        _importMessage = null;

        try
        {
            // Thing Descriptions are small JSON-LD documents; cap the read at 16 MB.
            string contents;
            using (StreamReader reader = new(file.OpenReadStream(16 * 1024 * 1024)))
            {
                contents = await reader.ReadToEndAsync();
            }

            if (TryOpenThingModelDialog(file.Name, contents))
            {
                return;
            }

            await ImportContentsAsync(file.Name, contents);
        }
        catch (Exception ex)
        {
            _importError = $"Failed to import '{file.Name}': {ex.Message}";
        }
        finally
        {
            _importing = false;
            // Reset the file input so the same file can be selected again.
            _inputKey = Guid.NewGuid();
        }
    }

    private async Task ImportContentsAsync(string fileName, string contents)
    {
        UANodeManager manager = UANodeManager.Instance
            ?? throw new InvalidOperationException("The OPC UA server is not ready yet. Please try again in a moment.");

        string importedFileName = await manager.ImportWoTFileAsync(fileName, contents);

        Reload();

        WoTFileInfo imported = _files?.FirstOrDefault(
            f => string.Equals(f.FileName, importedFileName, StringComparison.OrdinalIgnoreCase));

        if (imported is not null)
        {
            Select(imported);
        }

        _importMessage = $"Imported '{fileName}' successfully.";
    }

    // ---------- Thing Model -> Thing Description ----------

    /// <summary>
    /// A Thing Model cannot be onboarded as is: its placeholders ("{{NAME}}") need real
    /// values first, like in the UA-WoTMapper tool. Opens the dialog that asks for them
    /// when <paramref name="contents"/> is a Thing Model or still has placeholders.
    /// </summary>
    private bool TryOpenThingModelDialog(string fileName, string contents)
    {
        WotMappingDocument document;
        try
        {
            document = WotMappingDocument.Parse(contents);
        }
        catch (Exception)
        {
            // Not a JSON object; the regular import reports why.
            return false;
        }

        IReadOnlyList<string> placeholders = document.FindPlaceholders();
        if (!document.IsThingModel && placeholders.Count == 0)
        {
            return false;
        }

        _thingModel = document;
        _thingModelFileName = fileName;
        _tmPlaceholders = placeholders;
        _tmValues.Clear();
        _tmName = document.HasName && !document.Name.Contains("{{", StringComparison.Ordinal) ? document.Name : string.Empty;
        _tmError = null;
        return true;
    }

    private void CancelThingModelDialog()
    {
        _thingModel = null;
        _tmError = null;
    }

    private async Task ConfirmThingModelDialogAsync()
    {
        if (_thingModel is null || string.IsNullOrWhiteSpace(_tmName))
        {
            return;
        }

        _importing = true;
        _tmError = null;
        _importError = null;
        _importMessage = null;

        try
        {
            string json = _thingModel.CreateThingDescriptionJson(_tmValues, _tmName);
            await ImportContentsAsync(_thingModelFileName, json);
            _thingModel = null;
        }
        catch (Exception ex)
        {
            // Keep the dialog open so the values can be corrected.
            _tmError = $"Failed to import '{_thingModelFileName}': {ex.Message}";
        }
        finally
        {
            _importing = false;
        }
    }

    private async Task OnboardAllAsync()
    {
        _onboarding = true;
        _importError = null;
        _importMessage = null;

        try
        {
            UANodeManager manager = UANodeManager.Instance
                ?? throw new InvalidOperationException("The OPC UA server is not ready yet. Please try again in a moment.");

            var (onboarded, alreadyLoaded, failed) = await manager.OnboardLocalWoTFilesAsync();
            string summary = $"Onboarded {onboarded} WoT file(s); {alreadyLoaded} already onboarded.";
            if (failed > 0)
            {
                _importError = summary + $" {failed} failed; see the server log for details.";
            }
            else
            {
                _importMessage = summary;
            }
        }
        catch (Exception ex)
        {
            _importError = $"Onboarding failed: {ex.Message}";
        }
        finally
        {
            _onboarding = false;
            Reload();
        }
    }

    private async Task UnloadAsync(WoTFileInfo file)
    {
        if (file is null)
        {
            return;
        }

        _unloading = true;
        _importError = null;
        _importMessage = null;

        try
        {
            UANodeManager manager = UANodeManager.Instance
                ?? throw new InvalidOperationException("The OPC UA server is not ready yet. Please try again in a moment.");

            // Unloading disconnects the southbound driver asynchronously, so the
            // render thread is not blocked on its network I/O.
            bool deleted = await manager.UnloadWoTFileAsync(file.FileName);

            if (deleted)
            {
                _importMessage = $"Deleted '{DisplayName(file)}'.";
                if (_selected?.FileName == file.FileName)
                {
                    _selected = null;
                }
            }
            else
            {
                _importError = $"Could not delete '{DisplayName(file)}'; see the server log for details.";
            }
        }
        catch (Exception ex)
        {
            _importError = $"Failed to delete '{DisplayName(file)}': {ex.Message}";
        }
        finally
        {
            _unloading = false;
            Reload();
        }
    }

    private void ParseSelected()
    {
        _selectedJson = null;

        if (_selected is null)
        {
            return;
        }

        try
        {
            _selectedJson = JToken.Parse(_selected.RawJson);
        }
        catch (Exception)
        {
            // Fall back to the raw text view when the document cannot be parsed.
            _selectedJson = null;
        }
    }

    private static string DisplayName(WoTFileInfo file)
        => !string.IsNullOrEmpty(file.Title) ? file.Title
            : !string.IsNullOrEmpty(file.Name) ? file.Name
                : file.FileName;

    private static string Scheme(string baseUri)
    {
        if (string.IsNullOrEmpty(baseUri))
        {
            return "unknown";
        }

        int index = baseUri.IndexOf("://", StringComparison.Ordinal);
        return index > 0 ? baseUri[..index] : "unknown";
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        double kilobytes = bytes / 1024d;
        return kilobytes < 1024 ? $"{kilobytes:0.#} KB" : $"{kilobytes / 1024d:0.#} MB";
    }
}
