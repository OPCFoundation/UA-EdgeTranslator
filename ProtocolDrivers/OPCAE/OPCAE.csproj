<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x86;x64</Platforms>
    <!-- Deliberately no explicit <PlatformTarget>. Like OPCDA, this driver's
         x86 requirement is a runtime concern satisfied by publishing with
         win-x86; forcing architecture-specific compilation causes CS8012 in
         mixed solution builds when referenced projects are configured x64. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Official OPC Foundation Classic .NET API. Its net10.0-windows target
         brings the COM RCW and managed API needed for local OPC A&E. -->
    <PackageReference Include="Quick.OpcNetApi" />
    <PackageReference Include="Quick.OpcNetApi.Com" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\UAServer\UAEdgeTranslator.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
      <SetTargetFramework>TargetFramework=net10.0-windows</SetTargetFramework>
      <SetPlatform>Platform=x86</SetPlatform>
      <GlobalPropertiesToRemove>RuntimeIdentifier</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemGroup>

</Project>